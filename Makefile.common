
EMU      = $(CORE_DIR)/src
LIBRETRO = $(CORE_DIR)/libretro
DEPS_DIR = $(CORE_DIR)/deps

INCFLAGS := -I$(EMU) -I$(EMU)/od-pandora -I$(EMU)/include -I$(EMU)/archivers \
	-I$(LIBRETRO) -I$(LIBRETRO)/libco -I$(LIBRETRO)/core -I$(LIBRETRO)/include \
	-I$(DEPS_DIR)/zlib -I$(DEPS_DIR)/libretro-common/include \
	-I$(CORE_DIR)
