ifeq ($(USE_PICASSO96), 1)
	OBJS += $(EMU)/od-pandora/picasso96.o
endif

ifeq ($(AARCH64), 1)
	OBJS += src/od-pandora/aarch64_helper.o
else ifeq ($(HAVE_NEON), 1)
	OBJS += src/od-pandora/neon_helper.o
else
	OBJS += $(EMU)/od-pandora/arm_helper.o
endif


OBJS += $(EMU)/newcpu.o
OBJS += $(EMU)/newcpu_common.o
OBJS += $(EMU)/readcpu.o
